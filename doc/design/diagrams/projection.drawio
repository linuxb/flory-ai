                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eb7" value="evidence path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;dashed=1;fontFamily=LXGW WenKai TC;strokeColor=#6741D9;fontColor=#6741D9;" parent="1" source="b-shadow" target="b-evidence" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="an-shadow" value="Same events, two projection paths. Conflating them is a bug in both directions: keep them in surface and the planner believes a disproven path is still open; drop them entirely and the planner repeats the mistake it just made." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontFamily=LXGW WenKai TC;fontColor=#E03131;" parent="1" vertex="1">
                    <mxGeometry x="720" y="580" width="500" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="t-c" value="C. Offline evaluation ladder - liveness rises left to right; writes remain disabled" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontFamily=LXGW WenKai TC;fontColor=#6741D9;" parent="1" vertex="1">
                    <mxGeometry x="40" y="750" width="1100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="c-z1" value="Recorded - pure replay, zero live calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2F2BB;fontSize=13;fontStyle=1;strokeWidth=2;dashed=1;opacity=50;verticalAlign=top;fontFamily=LXGW WenKai TC;strokeColor=#2F9E44;fontColor=#2F9E44;" parent="1" vertex="1">
                    <mxGeometry x="40" y="800" width="480" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="c-z2" value="Model-live - model pins run fresh, tools stay recorded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D8FF;fontSize=13;fontStyle=1;strokeWidth=2;dashed=1;opacity=50;verticalAlign=top;fontFamily=LXGW WenKai TC;strokeColor=#1971C2;fontColor=#1971C2;" parent="1" vertex="1">
                    <mxGeometry x="560" y="800" width="480" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="c-z3" value="Reads-live - model and read-only tools run fresh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEC99;fontSize=13;fontStyle=1;strokeWidth=2;dashed=1;opacity=50;verticalAlign=top;fontFamily=LXGW WenKai TC;strokeColor=#F08C00;fontColor=#F08C00;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="800" width="480" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="c-l1a" value="No substitutions: replay the source with recorded outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2F2BB;fontSize=12;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#2F9E44;fontColor=#2F9E44;" parent="1" vertex="1">
