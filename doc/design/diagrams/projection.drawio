        <mxCell id="d-arr2" edge="1" parent="1" source="d-b7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=LXGW WenKai TC;strokeColor=#0C8599;fontColor=#0C8599;" target="d-l1" value="linearize() orders + trims">
