        <mxCell id="eb6" edge="1" parent="1" source="b-shadow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontFamily=LXGW WenKai TC;strokeColor=#0C8599;fontColor=#0C8599;" target="b-surfacex" value="visibility path">
          <mxGeometry relative="1" as="geometry" />
