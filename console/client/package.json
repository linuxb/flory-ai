{
    "name": "flory-console-client",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "verify": "npm run typecheck && npm run test && vite build"
    },
    "dependencies": {
        "@xyflow/react": "^12.8.6",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.0.0",
        "typescript": "^5.7.2",
        "vite": "^7.0.0",
        "vitest": "^2.1.8"
    }
}
