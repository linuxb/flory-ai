                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="an-triple" value="Complete provenance belongs in fork/created: source run + at_vertex_id + eval_up_to_seq + substitutions + fold_mode + evaluator pin + projector_version + harness_state_version.&amp;nbsp;&lt;div&gt;Missing any versioned dependency makes the historical result impossible to reproduce.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=LXGW WenKai TC;fontColor=#E8590C;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1100" width="1520" height="50" as="geometry"/>
                </mxCell>
