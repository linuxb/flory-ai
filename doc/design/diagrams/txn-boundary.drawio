        <mxCell id="e-freeze" edge="1" parent="1" source="rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;dashed=1;fontFamily=LXGW WenKai TC;strokeColor=#F08C00;fontColor=#F08C00;" target="zone" value="freeze / reject with violations">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="savepoint" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B2F2BB;fontSize=13;fontStyle=1;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#2F9E44;fontColor=#2F9E44;" value="Savepoint&lt;br&gt;S0" vertex="1">
          <mxGeometry height="70" width="100" x="40" y="370" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D8FF;fontSize=13;fontStyle=1;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#1971C2;fontColor=#1971C2;" value="Reserve stock&lt;br&gt;TCC try · reversible" vertex="1">
          <mxGeometry height="70" width="200" x="220" y="270" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D8FF;fontSize=13;fontStyle=1;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#1971C2;fontColor=#1971C2;" value="Set promo price&lt;br&gt;saga · compensable" vertex="1">
          <mxGeometry height="70" width="200" x="220" y="480" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFC9C9;fontSize=13;fontStyle=1;strokeWidth=3;fontFamily=LXGW WenKai TC;strokeColor=#E03131;fontColor=#E03131;" value="Create shipment&lt;br&gt;PIVOT · irreversible" vertex="1">
          <mxGeometry height="80" width="190" x="500" y="370" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2F2BB;fontSize=13;fontStyle=1;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#2F9E44;fontColor=#2F9E44;" value="Update listing&lt;br&gt;idempotent retry" vertex="1">
          <mxGeometry height="70" width="160" x="740" y="290" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2F2BB;fontSize=13;fontStyle=1;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#2F9E44;fontColor=#2F9E44;" value="Notify channel&lt;br&gt;bufferable" vertex="1">
          <mxGeometry height="70" width="160" x="740" y="470" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="n1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontFamily=LXGW WenKai TC;strokeColor=#1971C2;" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="n2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontFamily=LXGW WenKai TC;strokeColor=#1971C2;" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontFamily=LXGW WenKai TC;strokeColor=#E03131;fontColor=#E03131;" target="n4" value="forward only">
          <mxGeometry relative="1" x="-0.3333" y="-10" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontFamily=LXGW WenKai TC;strokeColor=#E03131;fontColor=#E03131;" target="n5" value="forward only">
          <mxGeometry relative="1" x="-0.3684" y="10" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
