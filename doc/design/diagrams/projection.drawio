                <mxCell id="eb5" value="reduce" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontFamily=LXGW WenKai TC;strokeColor=#2F9E44;fontColor=#2F9E44;" parent="1" source="b-reducer" target="b-view" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
