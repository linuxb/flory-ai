        <mxCell id="e-prop" edge="1" parent="1" source="planner" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontFamily=LXGW WenKai TC;strokeColor=#6741D9;fontColor=#6741D9;" target="rules" value="sub-DAG proposal">
          <mxGeometry relative="1" as="geometry" />
