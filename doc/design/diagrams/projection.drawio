        <mxCell id="t-a" value="A. Projection pipeline — from facts to prompt (each layer pure, independently cacheable and replaceable)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#6741D9;fontSize=15;fontStyle=1;fontFamily=LXGW WenKai TC;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/>
