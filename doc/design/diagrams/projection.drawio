        <mxCell id="an-fold" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontFamily=LXGW WenKai TC;fontColor=#1971C2;" value="Why not feed the raw events to the planner?&#xa;1. Correctness — &quot;which of the 12 results is current&quot; is arithmetic; models get it wrong, reducers do not.&#xa;2. Cost — thousands of tokens of tool output collapse into tens of tokens of state.&#xa;3. Testability — a reducer is a pure function over a typed event stream, exhaustively unit-testable.&#xa;Registry: a view declares source event types + a versioned reducer_ref; the ref is part of projector_version." vertex="1">
          <mxGeometry height="140" width="520" x="1040" y="380" as="geometry" />
        </mxCell>
        <mxCell id="b-shadow" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFC9C9;fontSize=12;fontStyle=1;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#E03131;fontColor=#E03131;" value="seq 34  subgraph/shadowed&#xa;competitor-price API branch disproven" vertex="1">
          <mxGeometry height="60" width="300" x="40" y="580" as="geometry" />
        </mxCell>
        <mxCell id="b-surfacex" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99E9F2;fontSize=12;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#0C8599;fontColor=#0C8599;" value="surface: DROPPED&#xa;planner must not think it is live" vertex="1">
          <mxGeometry height="60" width="240" x="440" y="555" as="geometry" />
        </mxCell>
        <mxCell id="b-evidence" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D0BFFF;fontSize=12;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#6741D9;fontColor=#6741D9;" value="assemble: RETAINED&#xa;as structured failure evidence" vertex="1">
