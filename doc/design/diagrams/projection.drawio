                <mxCell id="d-arr2" value="linearize() orders + trims" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=LXGW WenKai TC;strokeColor=#0C8599;fontColor=#0C8599;" parent="1" source="d-b7" target="d-l1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="d-note" value="Why vertex_id and never seq: v-b2 and v-b7 are parallel siblings with no dependency between them, so seq only records which HTTP response arrived first - network jitter, not business meaning.&amp;nbsp;&lt;div&gt;Ordering context by seq would make the same facts produce different prompts across runs, breaking replay determinism (a recorded log would no longer match) and destroying prompt-cache prefix stability. Lexicographic vertex_id is arbitrary but stable, which is exactly what is required.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=LXGW WenKai TC;fontColor=#1971C2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1540" width="1520" height="60" as="geometry"/>
                </mxCell>
