{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://flory.dev/idl/event-log/v1.schema.json",
    "title": "Flory Event Log v1",
    "type": "object",
    "required": ["event_type", "payload"],
    "properties": {
        "event_type": {"type": "string"},
        "vertex_id": {"type": ["string", "null"], "format": "uuid"},
        "parent_refs": {"type": "array", "items": {"type": "string", "format": "uuid"}},
        "planner_id": {"type": ["string", "null"], "format": "uuid"},
        "scope_id": {"type": ["string", "null"], "format": "uuid"},
        "pin_version": {"type": ["string", "null"]},
        "ignorable": {"type": "boolean", "default": false},
        "payload": {"type": "object"}
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "event_type": {
                        "not": {
                            "enum": [
                                "run/start",
                                "run/end",
                                "run/end-seed",
                                "subgraph/proposed",
                                "subgraph/frozen",
                                "subgraph/rejected",
                                "subgraph/shadowed",
                                "subgraph/unreadable",
                                "replan/boundary",
                                "fork/created",
                                "vertex/created",
                                "vertex/started",
                                "vertex/succeeded",
                                "vertex/failed",
                                "vertex/retried",
                                "txn/scope",
                                "txn/try",
                                "txn/confirm",
                                "txn/cancel",
                                "txn/pivot-passed",
                                "budget/charged",
                                "rule_template/published"
                            ]
                        }
                    }
                }
            },
            "then": {"required": ["ignorable"], "properties": {"ignorable": {"const": true}}}
        },
        {
            "if": {"properties": {"event_type": {"const": "run/start"}}, "required": ["event_type"]},
            "then": {"properties": {"payload": {"$ref": "#/$defs/runStartPayload"}}}
        },
        {
            "if": {"properties": {"event_type": {"const": "subgraph/proposed"}}, "required": ["event_type"]},
            "then": {"properties": {"payload": {"$ref": "#/$defs/subgraphProposedPayload"}}}
        },
        {"if": {"properties": {"event_type": {"const": "rule_template/published"}}, "required": ["event_type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/ruleTemplatePublishedPayload"}}}},
        {"if": {"properties": {"event_type": {"const": "subgraph/frozen"}}, "required": ["event_type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/subgraphFrozenPayload"}}}},
        {"if": {"properties": {"event_type": {"const": "subgraph/rejected"}}, "required": ["event_type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/subgraphRejectedPayload"}}}},
        {"if": {"properties": {"event_type": {"const": "subgraph/shadowed"}}, "required": ["event_type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/subgraphShadowedPayload"}}}},
        {"if": {"properties": {"event_type": {"const": "subgraph/unreadable"}}, "required": ["event_type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/subgraphUnreadablePayload"}}}},
        {"if": {"properties": {"event_type": {"const": "replan/boundary"}}, "required": ["event_type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/replanBoundaryPayload"}}}},
        {"if": {"properties": {"event_type": {"const": "vertex/created"}}, "required": ["event_type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/vertexCreatedPayload"}}}},
        {"if": {"properties": {"event_type": {"const": "txn/scope"}}, "required": ["event_type"]}, "then": {"required": ["scope_id"], "properties": {"payload": {"$ref": "#/$defs/txnScopePayload"}}}},
        {
            "if": {"properties": {"event_type": {"const": "txn/try"}}, "required": ["event_type"]},
            "then": {"required": ["scope_id", "vertex_id"], "properties": {"payload": {"$ref": "#/$defs/txnTryPayload"}}}
        },
        {
            "if": {"properties": {"event_type": {"const": "txn/confirm"}}, "required": ["event_type"]},
            "then": {"required": ["scope_id", "vertex_id"], "properties": {"payload": {"$ref": "#/$defs/txnConfirmPayload"}}}
        },
        {
            "if": {"properties": {"event_type": {"const": "txn/cancel"}}, "required": ["event_type"]},
            "then": {"required": ["scope_id"], "properties": {"payload": {"$ref": "#/$defs/txnCancelPayload"}}}
        },
        {
            "if": {"properties": {"event_type": {"const": "budget/charged"}}, "required": ["event_type"]},
            "then": {
                "required": ["vertex_id"],
                "properties": {
                    "vertex_id": {"type": "string", "format": "uuid"},
                    "payload": {"$ref": "#/$defs/budgetChargedPayload"}
                }
            }
        }
    ],
    "additionalProperties": false,
    "$defs": {
        "toolViewDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "authorizationIdentity": {
            "type": "object",
            "required": ["version", "key_id", "issuer", "subject", "roles", "subject_revision", "run_id", "authenticated_at", "signature"],
            "properties": {
                "version": {"const": "1"},
                "key_id": {"type": "string", "minLength": 1},
                "issuer": {"type": "string", "minLength": 1},
                "subject": {"type": "string", "minLength": 1},
                "roles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
                "subject_revision": {"type": "integer", "minimum": 0},
                "run_id": {"type": "string", "format": "uuid"},
                "authenticated_at": {"type": "string", "format": "date-time"},
                "signature": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
        },
        "runStartPayload": {
            "type": "object",
            "properties": {
                "schema_version": {"type": "string", "minLength": 1},
                "authorization_identity": {"$ref": "#/$defs/authorizationIdentity"}
            },
            "additionalProperties": true
        },
        "subgraphProposedPayload": {
            "type": "object",
            "required": ["tool_view_ref", "tool_view_digest"],
            "properties": {"tool_view_ref": {"type": "string", "minLength": 1}, "tool_view_digest": {"$ref": "#/$defs/toolViewDigest"}},
            "additionalProperties": true
        },
        "retryPolicy": {
            "type": "object",
            "required": ["max_attempts", "initial_backoff_ms", "multiplier", "max_backoff_ms"],
            "properties": {
                "max_attempts": {"type": "integer", "minimum": 1},
                "initial_backoff_ms": {"type": "integer", "minimum": 0},
                "multiplier": {"type": "number", "minimum": 1},
                "max_backoff_ms": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
        },
        "transactionSpec": {
            "type": "object",
            "required": ["effect_class", "mode"],
            "properties": {
                "effect_class": {"enum": ["none", "bufferable", "reversible", "irreversible"]},
                "mode": {"enum": ["plain", "tcc", "saga"]},
                "idempotency_key": {"type": "string", "minLength": 1},
                "try_timeout_s": {"type": "integer", "minimum": 1},
                "confirm_tool": {"type": "string", "minLength": 1},
                "cancel_tool": {"type": "string", "minLength": 1},
                "compensate_tool": {"type": "string", "minLength": 1},
                "status_tool": {"type": "string", "minLength": 1},
                "confirm_input": {"type": "object"},
                "cancel_input": {"type": "object"},
                "compensate_input": {"type": "object"}
            },
            "additionalProperties": false
        },
        "ruleTemplatePublishedPayload": {
            "type": "object",
            "required": ["template_ref", "digest", "diff", "author"],
            "properties": {
                "template_ref": {"type": "string", "minLength": 1},
                "digest": {"$ref": "#/$defs/toolViewDigest"},
                "predecessor_digest": {"$ref": "#/$defs/toolViewDigest"},
                "diff": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["op", "path"],
                        "properties": {
                            "op": {"enum": ["add", "remove", "replace", "move", "copy", "test"]},
                            "path": {"type": "string"},
                            "from": {"type": "string"},
                            "value": {}
                        },
                        "additionalProperties": false
                    }
                },
                "author": {"type": "string", "minLength": 1},
                "slot_id": {"type": "string", "minLength": 1},
                "capability": {
                    "type": "object",
                    "required": ["max_effect_class", "can_open_scope", "can_provide_pivot", "is_pure_read_only"],
                    "properties": {
                        "max_effect_class": {"enum": ["none", "bufferable", "reversible", "irreversible"]},
                        "can_open_scope": {"type": "boolean"},
                        "can_provide_pivot": {"type": "boolean"},
                        "is_pure_read_only": {"type": "boolean"}
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "subgraphFrozenPayload": {
            "type": "object",
            "required": ["proposed_seq", "tool_view_digest", "vertices"],
            "properties": {
                "proposed_seq": {"type": "integer", "minimum": 1},
                "tool_view_ref": {"type": "string", "minLength": 1},
                "tool_view_digest": {"$ref": "#/$defs/toolViewDigest"},
                "vertices": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["author_id", "vertex_id", "role"],
                        "properties": {
                            "author_id": {"type": "string", "minLength": 1},
                            "vertex_id": {"type": "string", "format": "uuid"},
                            "role": {"enum": ["planner", "tool", "router", "confirmation-barrier"]}
                        },
                        "additionalProperties": false
                    }
                },
                "scopes": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["author_id", "scope_id"],
                        "properties": {"author_id": {"type": "string", "minLength": 1}, "scope_id": {"type": "string", "format": "uuid"}},
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "subgraphUnreadablePayload": {
            "type": "object",
            "required": ["planner_vertex_id", "reason", "answer_digest"],
            "properties": {
                "planner_vertex_id": {"type": "string", "format": "uuid"},
                "reason": {"type": "string", "minLength": 1},
                "answer_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "answer_length": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
        },
        "subgraphShadowedPayload": {
            "type": "object",
            "required": ["vertex_ids", "reason"],
            "properties": {
                "vertex_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}},
                "reason": {"type": "string", "minLength": 1},
                "boundary_seq": {"type": "integer", "minimum": 1},
                "boundary_vertex_id": {"type": "string", "format": "uuid"},
                "failed_vertex_id": {"type": "string", "format": "uuid"}
            },
            "additionalProperties": false
        },
        "replanBoundaryPayload": {
            "type": "object",
            "required": ["level", "reason", "failed_vertex_id", "candidates"],
            "properties": {
                "level": {"enum": ["L1", "L2", "L3", "L4"]},
                "reason": {"type": "string", "minLength": 1},
                "failed_vertex_id": {"type": "string", "format": "uuid"},
                "boundary_seq": {"type": "integer", "minimum": 1},
                "boundary_vertex_id": {"type": "string", "format": "uuid"},
                "episode": {"type": "integer", "minimum": 1},
                "cancelled_scopes": {"type": "array", "items": {"type": "string", "format": "uuid"}},
                "estimated_cost": {"type": "number", "minimum": 0},
                "currency": {"type": "string", "minLength": 1},
                "candidates": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["planner_vertex_id"],
                        "properties": {
                            "planner_vertex_id": {"type": "string", "format": "uuid"},
                            "planner_seq": {"type": "integer", "minimum": 1},
                            "cost": {"type": "number", "minimum": 0},
                            "currency": {"type": "string", "minLength": 1},
                            "terms": {
                                "type": "object",
                                "properties": {
                                    "context_cost": {"type": "number", "minimum": 0},
                                    "rework_cost": {"type": "number", "minimum": 0},
                                    "compensation_cost": {"type": "number", "minimum": 0},
                                    "risk_premium": {"type": "number", "minimum": 1}
                                },
                                "additionalProperties": false
                            },
                            "rejected": {"enum": ["open_bracket", "below_floor", "savepoint_precedes", "budget_exceeded", "failure_counter_exhausted"]}
                        },
                        "additionalProperties": false
                    }
                },
                "selected": {"type": ["string", "null"], "format": "uuid"}
            },
            "additionalProperties": false
        },
        "subgraphRejectedPayload": {
            "type": "object",
            "required": ["proposed_seq", "stage", "violations"],
            "properties": {
                "proposed_seq": {"type": "integer", "minimum": 1},
                "stage": {"enum": ["resolution", "registry", "admission"]},
                "violations": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["rule", "message", "vertices"],
                        "properties": {
                            "rule": {"enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8", "R9", "R10", "R11", "R12", "R13", "R14"]},
                            "message": {"type": "string", "minLength": 1},
                            "vertices": {"type": "array", "items": {"type": "string", "minLength": 1}}
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "vertexCreatedPayload": {
            "oneOf": [
                {"type": "object", "required": ["role"], "properties": {"role": {"const": "planner"}}, "additionalProperties": true},
                {"type": "object", "required": ["role"], "properties": {"role": {"const": "confirmation-barrier"}}, "additionalProperties": false},
                {
                    "type": "object",
                    "required": ["role", "origin"],
                    "properties": {
                        "role": {"const": "router"},
                        "origin": {"enum": ["declared", "interposed"]},
                        "template_ref": {"type": "string", "minLength": 1},
                        "slot_id": {"type": "string", "minLength": 1},
                        "placement": {"enum": ["at_savepoint", "inside_scope"]}
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": ["role", "tool", "tool_version", "tool_view_digest", "input", "retry_policy", "txn"],
                    "properties": {
                        "role": {"const": "tool"},
                        "tool": {"type": "string", "minLength": 1},
                        "tool_version": {"type": "string", "minLength": 1},
                        "tool_view_digest": {"$ref": "#/$defs/toolViewDigest"},
                        "input": {"type": "object"},
                        "retry_policy": {"$ref": "#/$defs/retryPolicy"},
                        "txn": {"$ref": "#/$defs/transactionSpec"}
                    },
                    "additionalProperties": false
                }
            ]
        },
        "txnScopePayload": {
            "type": "object",
            "required": ["state"],
            "properties": {
                "state": {"enum": ["open", "committed", "cancelled", "suspended"]},
                "member_vertices": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
                "required_try_vertices": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
                "pivot_vertex": {"type": ["string", "null"], "format": "uuid"},
                "savepoint_seq": {"type": ["integer", "null"], "minimum": 1}
            },
            "additionalProperties": false
        },
        "txnTryPayload": {
            "type": "object",
            "required": ["idempotency_key", "deadline_at"],
            "properties": {
                "idempotency_key": {"type": "string", "minLength": 1},
                "deadline_at": {"type": "string", "format": "date-time"},
                "tool_view_digest": {"$ref": "#/$defs/toolViewDigest"},
                "confirm_tool": {"type": "string", "minLength": 1},
                "cancel_tool": {"type": "string", "minLength": 1},
                "compensate_tool": {"type": "string", "minLength": 1},
                "retry_policy": {"$ref": "#/$defs/retryPolicy"},
                "input": {"type": "object"}
            },
            "additionalProperties": false
        },
        "txnConfirmPayload": {"type": "object", "required": ["idempotency_key"], "properties": {"idempotency_key": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "txnCancelPayload": {
            "type": "object",
            "required": ["idempotency_key", "phase"],
            "properties": {
                "idempotency_key": {"type": "string", "minLength": 1},
                "phase": {"enum": ["requested", "completed"]},
                "reason": {"type": "string"}
            },
            "additionalProperties": false
        },
        "llmUsage": {
            "type": "object",
            "required": ["input_tokens", "output_tokens", "total_tokens", "reasoning_tokens", "cache_hit_input_tokens", "cache_miss_input_tokens"],
            "properties": {
                "input_tokens": {"type": "integer", "minimum": 0},
                "output_tokens": {"type": "integer", "minimum": 0},
                "total_tokens": {"type": "integer", "minimum": 0},
                "reasoning_tokens": {"type": "integer", "minimum": 0},
                "cache_hit_input_tokens": {"type": "integer", "minimum": 0},
                "cache_miss_input_tokens": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
        },
        "llmCostEstimate": {
            "type": "object",
            "required": ["currency", "amount", "pricing_ref", "rates_per_million"],
            "properties": {
                "currency": {"type": "string", "minLength": 1},
                "amount": {"type": "number", "minimum": 0},
                "pricing_ref": {"type": "string", "minLength": 1},
                "pricing_tier": {"type": "string", "minLength": 1},
                "rates_per_million": {
                    "type": "object",
                    "required": ["cache_hit_input", "cache_miss_input", "output"],
                    "properties": {
                        "cache_hit_input": {"type": "number", "minimum": 0},
                        "cache_miss_input": {"type": "number", "minimum": 0},
                        "output": {"type": "number", "minimum": 0}
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "budgetChargedPayload": {
            "type": "object",
            "required": ["category", "provider", "protocol", "endpoint", "requested_model", "response_model", "duration_ms", "usage"],
            "properties": {
                "category": {"const": "llm"},
                "provider": {"type": "string", "minLength": 1},
                "protocol": {"enum": ["openai-chat-completions", "anthropic-messages"]},
                "endpoint": {"type": "string", "minLength": 1},
                "requested_model": {"type": "string", "minLength": 1},
                "response_model": {"type": "string", "minLength": 1},
                "duration_ms": {"type": "number", "minimum": 0},
                "usage": {"$ref": "#/$defs/llmUsage"},
                "estimated_cost": {"$ref": "#/$defs/llmCostEstimate"}
            },
            "additionalProperties": false
        },
        "forkRequest": {
            "type": "object",
            "required": ["source_run_id", "at_vertex_id", "substitutions", "eval_up_to_seq", "fold_mode", "evaluator_pin", "projector_version", "harness_state_version"],
            "properties": {
                "source_run_id": {"type": "string", "format": "uuid"},
                "at_vertex_id": {"type": "string", "format": "uuid"},
                "eval_up_to_seq": {"type": "integer", "minimum": 1},
                "substitutions": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["run_seq", "pin_version"],
                        "properties": {"run_seq": {"type": "integer", "minimum": 1}, "pin_version": {"type": "string", "minLength": 1}},
                        "additionalProperties": false
                    }
                },
                "fold_mode": {"enum": ["recorded", "model-live", "reads-live"]},
                "evaluator_pin": {"type": "string", "minLength": 1},
                "projector_version": {"type": "string", "minLength": 1},
                "harness_state_version": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
        }
    }
}
