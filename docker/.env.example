# Settings for the optional local PostgreSQL container. Copy to `docker/.env` to override them.
# Docker Compose reads this file because `docker/` is the project directory of docker/compose.yml.
# The container creates POSTGRES_DB and POSTGRES_USER itself, and that user is a superuser, so
# `npm run db:setup` needs no administrative credentials on this path. Change POSTGRES_PORT when
# another server already holds 5432, and set the repository-root `.env` DATABASE_URL to match.
POSTGRES_DB=flory
POSTGRES_USER=flory
POSTGRES_PASSWORD=flory-dev-password
POSTGRES_PORT=5432
