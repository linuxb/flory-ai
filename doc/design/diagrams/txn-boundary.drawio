        <mxCell id="zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEC99;fontSize=14;fontStyle=1;strokeWidth=2;dashed=1;opacity=60;verticalAlign=top;fontFamily=LXGW WenKai TC;strokeColor=#F08C00;fontColor=#F08C00;" value="A. Transaction scope T1" vertex="1">
