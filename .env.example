# Local development settings. Copy to .env to override these values; the Node scripts and
# TypeScript integration tests load it automatically. Settings for the optional PostgreSQL
# container live in docker/.env.example instead.

# The owner connection. Every other connection follows its host, port, and database, so pointing
# the repository at an existing local server is usually this one line.
DATABASE_URL=postgresql://flory:flory-dev-password@127.0.0.1:5432/flory

# Administrative connection used only by `npm run db:bootstrap`, which creates the roles and the
# database above. Omit it when the server accepts the standard PGUSER/PGPASSWORD environment, and
# omit it with docker/compose.yml, where the owner above is already a superuser.
# FLORY_ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

ENGINE_DB_PASSWORD=engine-dev-password
COORDINATOR_DB_PASSWORD=coordinator-dev-password

# Derived from DATABASE_URL when unset. Set them explicitly only to override host, port, or database.
# Go services do not read this file, so export these two when running the Coordinator or its
# integration tests.
# ENGINE_DATABASE_URL=postgresql://engine_role:engine-dev-password@127.0.0.1:5432/flory
# COORDINATOR_DATABASE_URL=postgresql://coordinator_role:coordinator-dev-password@127.0.0.1:5432/flory

COORDINATOR_WORKER_ID=coordinator-local
COORDINATOR_HEALTH_ADDR=127.0.0.1:8091
ADAPTER_BASE_URL=http://127.0.0.1:8090
SANDBOX_ADDR=127.0.0.1
SANDBOX_PORT=8090

# gatewayd. The blob backend is `memory` for a dependency-free local run, or `gcs` against a real
# bucket or an emulator. STORAGE_EMULATOR_HOST must match fake-gcs-server's -public-host: when it
# does not, writes land but reads resolve to nothing, which looks like an empty bucket.
GATEWAYD_HTTP_ADDR=127.0.0.1:8092
GATEWAYD_GRPC_ADDR=127.0.0.1:8093
GATEWAYD_BLOB_BACKEND=memory
GATEWAYD_BLOB_BUCKET=flory-tool-views
# STORAGE_EMULATOR_HOST=http://localhost:4443

# What a tool service registers against, and how often it renews its lease.
GATEWAYD_BASE_URL=http://127.0.0.1:8093
GATEWAYD_HEARTBEAT_MS=5000

# What the executors call. ADAPTER_MODE=direct bypasses contract pinning and argument validation,
# and exists for the dual-path equivalence fixture and gateway-less debugging.
GATEWAY_BASE_URL=http://127.0.0.1:8092
ADAPTER_MODE=gateway
