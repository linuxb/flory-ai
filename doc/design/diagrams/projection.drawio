        <mxCell id="eb7" edge="1" parent="1" source="b-shadow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;dashed=1;fontFamily=LXGW WenKai TC;strokeColor=#6741D9;fontColor=#6741D9;" target="b-evidence" value="evidence path">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="an-shadow" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontFamily=LXGW WenKai TC;fontColor=#E03131;" value="Same events, two projection paths. Conflating them is a bug in both directions: keep them in surface and the planner believes a disproven path is still open; drop them entirely and the planner repeats the mistake it just made." vertex="1">
          <mxGeometry height="90" width="500" x="720" y="580" as="geometry" />
        </mxCell>
        <mxCell id="t-c" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontFamily=LXGW WenKai TC;fontColor=#6741D9;" value="C. Three-tier A/B on the same log — cost rises left to right, so does what it can prove" vertex="1">
          <mxGeometry height="30" width="1100" x="40" y="750" as="geometry" />
        </mxCell>
        <mxCell id="c-z1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2F2BB;fontSize=13;fontStyle=1;strokeWidth=2;dashed=1;opacity=50;verticalAlign=top;fontFamily=LXGW WenKai TC;strokeColor=#2F9E44;fontColor=#2F9E44;" value="L1 Replay A/B — offline, zero cost" vertex="1">
          <mxGeometry height="280" width="480" x="40" y="800" as="geometry" />
        </mxCell>
        <mxCell id="c-z2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D8FF;fontSize=13;fontStyle=1;strokeWidth=2;dashed=1;opacity=50;verticalAlign=top;fontFamily=LXGW WenKai TC;strokeColor=#1971C2;fontColor=#1971C2;" value="L2 Counterfactual dry-run fork — one model call, no side effects" vertex="1">
          <mxGeometry height="280" width="480" x="560" y="800" as="geometry" />
        </mxCell>
        <mxCell id="c-z3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEC99;fontSize=13;fontStyle=1;strokeWidth=2;dashed=1;opacity=50;verticalAlign=top;fontFamily=LXGW WenKai TC;strokeColor=#F08C00;fontColor=#F08C00;" value="L3 Live A/B — real traffic, real effects" vertex="1">
          <mxGeometry height="280" width="480" x="1080" y="800" as="geometry" />
        </mxCell>
        <mxCell id="c-l1a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2F2BB;fontSize=12;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#2F9E44;fontColor=#2F9E44;" value="Pin log prefix, swap assemble version only" vertex="1">
          <mxGeometry height="55" width="420" x="70" y="860" as="geometry" />
        </mxCell>
        <mxCell id="c-l1b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2F2BB;fontSize=11;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#2F9E44;fontColor=#2F9E44;" value="Diff the two prompts&#xa;Proves: size, key facts present, rules fired&#xa;Cannot prove: any model behaviour&#xa;Use: CI gate on every refine" vertex="1">
          <mxGeometry height="100" width="420" x="70" y="950" as="geometry" />
        </mxCell>
        <mxCell id="c-l2a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D8FF;fontSize=12;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#1971C2;fontColor=#1971C2;" value="fork(planner boundary) → replan with arm B as a DRY RUN: read-only tools run, every write is skipped" vertex="1">
          <mxGeometry height="55" width="420" x="590" y="860" as="geometry" />
        </mxCell>
        <mxCell id="c-l2b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D8FF;fontSize=11;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#1971C2;fontColor=#1971C2;" value="Compare the two plans&#xa;Proves: check-rule pass rate, plan size, mis-declared pivots, judge score&#xa;Unique to a log: ask &quot;what would B have planned&quot; at any past decision point. Fork is reserved for this offline family; online replan never forks&#xa;Also compares recovery strategies: fork twice from one failure seq" vertex="1">
          <mxGeometry height="100" width="420" x="590" y="950" as="geometry" />
        </mxCell>
        <mxCell id="c-l3a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEC99;fontSize=12;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#F08C00;fontColor=#F08C00;" value="Split by RUN (never by turn) · run/start records the attribution triple" vertex="1">
          <mxGeometry height="55" width="420" x="1110" y="860" as="geometry" />
        </mxCell>
        <mxCell id="c-l3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEC99;fontSize=11;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#F08C00;fontColor=#F08C00;" value="Metrics folded from the log, not telemetry&#xa;replan rate · tokens/task · post-pivot suspension · business success&#xa;Guardrails veto: cheaper tokens + more suspensions = catastrophe&#xa;Stratify by task type × SKU bucket × contains-pivot" vertex="1">
          <mxGeometry height="100" width="420" x="1110" y="950" as="geometry" />
        </mxCell>
