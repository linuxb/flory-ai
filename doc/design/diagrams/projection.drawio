                </mxCell>
                <mxCell id="c-l1b" value="Assert byte-identical surfaces&#xa;Proves: projection and pin completeness&#xa;No model calls /  no tool calls&#xa;Use: replay CI and prompt diffs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2F2BB;fontSize=11;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#2F9E44;fontColor=#2F9E44;" parent="1" vertex="1">
                    <mxGeometry x="70" y="950" width="420" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c-l2a" value="fork(at_vertex_id, eval_up_to_seq) + pin substitutions, fold_mode: model-live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D8FF;fontSize=12;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#1971C2;fontColor=#1971C2;" parent="1" vertex="1">
                    <mxGeometry x="590" y="860" width="420" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="c-l2b" value="Compare plans for this history&#xa;Measures: check-rule verdict, plan size, model cost, judge score&#xa;Recorded tool observations stay fixed&#xa;Every side-effecting node is skipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D8FF;fontSize=11;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#1971C2;fontColor=#1971C2;" parent="1" vertex="1">
                    <mxGeometry x="590" y="950" width="420" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c-l3a" value="fold_mode: reads-live /  effect_class: none tools only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEC99;fontSize=12;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#F08C00;fontColor=#F08C00;" parent="1" vertex="1">
                    <mxGeometry x="1110" y="860" width="420" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="c-l3b" value="Current quotes and availability may run&#xa;Every write is skipped and labelled unverified&#xa;Live reads are present-time observations&#xa;Result remains scoped to this history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEC99;fontSize=11;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#F08C00;fontColor=#F08C00;" parent="1" vertex="1">
