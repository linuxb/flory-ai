        <mxCell id="planner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D0BFFF;fontSize=14;fontStyle=1;strokeWidth=2;fontFamily=LXGW WenKai TC;strokeColor=#6741D9;fontColor=#6741D9;" value="Planner&lt;br&gt;declares txn scope + node attrs" vertex="1">
